{% extends 'base.html.twig' %}

{% block title %}New Workshops{% endblock %}

{% block body %}
{{ parent() }}
<div class="preloader">
    <div class="lds-ripple">
        <div></div>
        <div></div>
    </div>
</div><!-- /.preloader -->

<div class="page-wrapper">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <!-- Titre de la page -->
                <h1 class="text-center mb-4">Créer un nouveau workshop</h1>

                <!-- Formulaire de création -->
                <div class="card shadow-sm">
                    <div class="card-body">
                        {{ form_start(form) }}
                            <div class="form-group">
                                {{ form_label(form.titre, 'Titre', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                            </div>

                            <div class="form-group">
                                {{ form_label(form.video, 'Upload Video', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.video, {'attr': {'class': 'form-control-file'}}) }}
                            </div>

                            <div class="form-group text-center">
                                <button type="submit" class="btn btn-primary">{{ button_label|default('Save') }}</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>

                <!-- Bouton "Retour à la liste" -->
                <div class="mt-4 text-center">
                    <a href="{{ path('app_workshops_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
</div><!-- /.page-wrapper -->

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Font Awesome pour les icônes -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

 <style>
        h1 {
            color: black; /* Couleur du texte */
            font-weight: bold; /* Texte en gras */
            animation: mouvement 2s infinite alternate; /* Effet de mouvement */
        }

        @keyframes mouvement {
            0% {
                transform: translateX(0);
            }
            50% {
                transform: translateX(20px);
            }
            100% {
                transform: translateX(0);
            }
        }
    </style>
{% endblock %}