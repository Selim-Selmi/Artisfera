{% extends 'base.html.twig' %}

{% block title %}Workshops - {{ workshop.titre }}{% endblock %}

{% block body %}
{{ parent() }}
<div class="preloader">
    <div class="lds-ripple">
        <div></div>
        <div></div>
    </div>
</div><!-- /.preloader -->

<div class="page-wrapper">
    <div class="container mt-5">
        <!-- Titre de la page -->
        <h1 class="text-center mb-4">{{ workshop.titre }}</h1>

        <!-- Conteneur principal pour la vidéo et la description -->
        <div class="row">
            <!-- Vidéo à gauche -->
            <div class="col-md-6">
                <div class="video-container mb-4">
                    <video controls class="w-100 rounded shadow-sm">
                        <source src="{{ asset('uploads/videos/' ~ workshop.video) }}" type="video/mp4">
                        Votre navigateur ne supporte pas la lecture de vidéos.
                    </video>
                </div>
            </div>

            <!-- Description à droite -->
            <div class="col-md-6">
                <div class="description-container p-4 bg-light rounded shadow-sm">
                    <h2 class="mb-3">Description</h2>
                    <p class="lead">{{ workshop.description }}</p>
                </div>
            </div>
        </div>

        <!-- Boutons d'action -->
        <div class="mt-4 text-center">
            <a href="{{ path('app_workshops_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ path('app_workshops_edit', {'id': workshop.id}) }}" class="btn btn-outline-primary">
                <i class="fas fa-edit"></i> Modifier
            </a>
            {{ include('workshops/_delete_form.html.twig') }}
        </div>
    </div>
</div><!-- /.page-wrapper -->

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Font Awesome pour les icônes -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

<style>
/* Style pour le conteneur de la vidéo */
.video-container {
    background-color: #f8f9fa;
    padding: 15px;
    border-radius: 10px;
}

/* Style pour la description */
.description-container {
    background-color: #fff;
    border: 1px solid #ddd;
    height: 100%; /* Pour que la description prenne toute la hauteur */
}

/* Style pour les boutons */
.btn {
    margin: 5px;
    padding: 10px 20px;
    border-radius: 5px;
    font-size: 1rem;
    transition: background-color 0.3s ease, transform 0.2s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-outline-secondary {
    border-color: #6c757d;
    color: #6c757d;
}

.btn-outline-secondary:hover {
    background-color: #6c757d;
    color: #fff;
}

.btn-outline-primary {
    border-color: #007bff;
    color: #007bff;
}

.btn-outline-primary:hover {
    background-color: #007bff;
    color: #fff;
}

/* Style pour le bouton de suppression */
form {
    display: inline-block;
}

form button {
    background-color: #dc3545;
    color: #fff;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

form button:hover {
    background-color: #c82333;
}
</style>

 <style>
        h1 {
            color: black; /* Couleur du texte */
            font-weight: bold; /* Texte en gras */
            animation: mouvement 2s infinite alternate; /* Effet de mouvement */
        }

        @keyframes mouvement {
            0% {
                transform: translateX(0);
            }
            50% {
                transform: translateX(20px);
            }
            100% {
                transform: translateX(0);
            }
        }
    </style>
{% endblock %}