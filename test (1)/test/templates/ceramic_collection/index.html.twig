{% extends 'base.html.twig' %}

{% block title %}CeramicCollection index{% endblock %}

{% block body %}
{{ parent() }}
    <div class="container mt-4">
        <h1 class="mb-4">Ceramic Collections</h1>

        <table class="table table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Nom de la collection</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for ceramic_collection in ceramic_collections %}
                <tr>
                    <td>{{ ceramic_collection.nomC }}</td>
                    <td>{{ ceramic_collection.descriptionC }}</td>
                    <td>
                        {% if ceramic_collection.userid == app.user.id %}
                        <a href="{{ path('app_ceramic_collection_show', {'id': ceramic_collection.id}) }}" >
                            <i class="fas fa-eye"></i> <!-- Icône œil pour Show -->
                        </a>
                        <a href="{{ path('app_ceramic_collection_edit', {'id': ceramic_collection.id}) }}" >
                            <i class="fas fa-pencil-alt"></i> <!-- Icône crayon pour Edit -->
                        </a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if 'ROLE_CERAMIQUE' in app.user.roles %}
        <a href="{{ path('app_ceramic_collection_new') }}" class="btn btn-success">+ Create new</a>
        {% endif %}
    </div>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
{% endblock %}