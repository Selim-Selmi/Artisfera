{% extends 'base.html.twig' %}

{% block title %}{{ ceramic_collection.nomC }}{% endblock %}

{% block body %}
{{ parent() }}
  <div class="preloader">
    <div class="lds-ripple">
        <div></div>
        <div></div>
    </div>
  </div><!-- /.preloader -->

  <div class="page-wrapper">
    <section class="collection-grid collection-masonary">
        <div class="container">
            <!-- Titre et description de la collection -->
            <div class="collection-header text-center mb-5">
                <h1 class="display-4 font-weight-bold">{{ ceramic_collection.nomC }}</h1>
                <p class="lead text-muted">{{ ceramic_collection.descriptionC }}</p>
            </div>

            <!-- Boutons d'action -->
            <div class="text-center mb-4">
                <div class="btn-group" role="group" aria-label="Actions de la collection">
                    <a href="{{ path('app_ceramic_collection_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                    <a href="{{ path('app_ceramic_collection_edit', {'id': ceramic_collection.id}) }}" class="btn btn-outline-primary">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    {{ include('ceramic_collection/_delete_form.html.twig') }}
                </div>
            </div>

            <!-- Liste des œuvres -->
            <h2 class="mt-4 mb-4 text-center">Œuvres de cette collection</h2>

            <div class="row high-gutter filter-layout masonary-layout">
                {% if oeuvres is not empty %}
                    {% for oeuvre in oeuvres %}
                        <div class="col-lg-4 col-md-6 filter-item masonary-item pic">
                            <div class="collection-grid__single">
                                <div class="collection-grid__image">
                                    <img src="{{ asset('uploads/images/' ~ oeuvre.image) }}" alt="Image de l'œuvre {{ oeuvre.nom }}">
                                    
                                    <!-- Bouton pour ouvrir le modal -->
                                    <a href="#" class="collection-grid__link" data-bs-toggle="modal" data-bs-target="#oeuvreModal{{ oeuvre.id }}">+</a>
                                </div>
                                <div class="collection-grid__content">
                                    <h3><a href="#">{{ oeuvre.nom }}</a></h3>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Détails avec image à gauche et infos à droite -->
                        <div class="modal fade" id="oeuvreModal{{ oeuvre.id }}" tabindex="-1" aria-labelledby="oeuvreModalLabel{{ oeuvre.id }}" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="oeuvreModalLabel{{ oeuvre.id }}">{{ oeuvre.nom }}</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row">
                                            <!-- Image à gauche -->
                                            <div class="col-md-5">
                                                <img src="{{ asset('uploads/images/' ~ oeuvre.image) }}" class="img-fluid rounded" alt="{{ oeuvre.nom }}">
                                            </div>
                                            <!-- Infos à droite -->
                                            <div class="col-md-7">
                                                <p><strong>Type:</strong> {{ oeuvre.type }}</p>
                                                <p><strong>Description:</strong> {{ oeuvre.description }}</p>
                                                <p><strong>Matière:</strong> {{ oeuvre.matiere }}</p>
                                                <p><strong>Couleur:</strong> {{ oeuvre.couleur }}</p>
                                                <p><strong>Dimensions:</strong> {{ oeuvre.dimensions }}</p>
                                                <p><strong>Créateur:</strong> {{ oeuvre.createur }}</p>
                                                <p><strong>Catégorie:</strong> {{ oeuvre.categorie }}</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="text-center">Aucune œuvre n'a été ajoutée à cette collection.</p>
                {% endif %}
            </div><!-- /.row -->
        </div><!-- /.container -->
    </section><!-- /.collection-grid -->
  </div><!-- /.page-wrapper -->

  <a href="#" data-target="html" class="scroll-to-target scroll-to-top"><i class="fa fa-angle-up"></i></a>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Font Awesome pour les icônes -->
  <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>


  <style>
  /* Style pour le titre et la description */
.collection-header h1 {
    font-size: 2.5rem;
    color: #333;
    margin-bottom: 1rem;
}

.collection-header p {
    font-size: 1.2rem;
    color: #666;
}

/* Style pour les boutons */
.btn-group .btn {
    margin: 0 5px;
    padding: 10px 20px;
    border-radius: 5px;
    font-size: 1rem;
    transition: background-color 0.3s ease, transform 0.2s ease;
}

.btn-group .btn:hover {
    transform: translateY(-2px);
}

.btn-outline-secondary {
    border-color: #6c757d;
    color: #6c757d;
}

.btn-outline-secondary:hover {
    background-color: #6c757d;
    color: #fff;
}

.btn-outline-primary {
    border-color: #007bff;
    color: #007bff;
}

.btn-outline-primary:hover {
    background-color: #007bff;
    color: #fff;
}

/* Style pour le bouton de suppression */
form {
    display: inline-block;
}

form button {
    background-color: #dc3545;
    color: #fff;
    border: none;
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

form button:hover {
    background-color: #c82333;
   
}
  </style>
{% endblock %}