.btn-nude {
    background: linear-gradient(135deg, rgb(25, 75, 145) 0%, rgb(45, 103, 161) 100%);
    border: 1px solid rgb(25, 75, 145);
    color: white;
    padding: 10px 20px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 8px;
    transition: background 0.3s ease, transform 0.2s ease;
     min-width: 350px;
}

/* Effet au survol */
