<script>
document.addEventListener("DOMContentLoaded", function() {
    const searchForm = document.getElementById('search-form');
    const searchInput = document.getElementById('search-input');
    const filterType = document.getElementById('filter-type');
    const oeuvresContainer = document.querySelector('.row.high-gutter.filter-layout.masonary-layout');

    searchForm.addEventListener('submit', function(event) {
        event.preventDefault(); // Prevent default form submission

        const query = searchInput.value.trim();
        const filterBy = filterType.value; 

        if (query.length > 0) {
            fetch(`/galerieceramic/search?query=${encodeURIComponent(query)}&filterBy=${filterBy}`, {
                method: 'GET',
                headers: { 'Accept': 'application/json' },
            })
            .then(response => response.ok ? response.json() : Promise.reject('Erreur réseau'))
            .then(data => {
                oeuvresContainer.innerHTML = ''; // Clear previous results

                if (data.length === 0) {
                    oeuvresContainer.innerHTML = '<p class="text-center">Aucune œuvre trouvée.</p>';
                } else {
                    data.forEach(oeuvre => {
                        const oeuvreHtml = `
                            <div class="col-lg-4 col-md-6 filter-item masonary-item pic">
                                <div class="collection-grid__single">
                                    <div class="collection-grid__image">
                                        <img src="/uploads/images/${oeuvre.image}" class="img-fluid rounded" alt="${oeuvre.nom}">
                                        <a href="/galerieceramic/oeuvre/${oeuvre.id}" class="collection-grid__link" data-bs-toggle="modal" data-bs-target="#oeuvreModal${oeuvre.id}">+</a>
                                    </div>
                                    <div class="collection-grid__content">
                                        <h3><a href="#">${oeuvre.nom}</a></h3>
                                        <p><strong>${oeuvre.categorie}</strong> | ${oeuvre.couleur} | ${oeuvre.type} | ${oeuvre.matiere} </p>
                                    </div>
                                </div>
                            </div>
                        `;
                        oeuvresContainer.insertAdjacentHTML('beforeend', oeuvreHtml);
                    });
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                oeuvresContainer.innerHTML = '<p class="text-center">Une erreur s\'est produite.</p>';
            });
        } else {
            window.location.reload();
        }
    });
});
</script>



<script>
function showComment(oeuvreId) {
    // Get the comment form for the specified artwork (oeuvre)
    const commentForm = document.getElementById('comment-form-' + oeuvreId);

    // Toggle the visibility of the comment form
    if (commentForm.style.display === 'none' || commentForm.style.display === '') {
        commentForm.style.display = 'block'; // Show the comment form
    } else {
        commentForm.style.display = 'none'; // Hide the comment form
    }
}
</script>

