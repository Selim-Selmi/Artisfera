    background: linear-gradient(135deg, rgb(20, 65, 125) 0%, rgb(35, 93, 150) 100%);
    transform: translateY(-2px);
}

/* Effet au clic */
.btn-nude:active {
    background: linear-gradient(135deg, rgb(15, 55, 115) 0%, rgb(30, 85, 140) 100%);
    transform: translateY(0);
}

/* Menu déroulant */
.dropdown-menu {
    border: 1px solid rgb(60, 120, 190);
    border-radius: 8px;
    background: linear-gradient(135deg, rgb(230, 245, 255) 0%, rgb(200, 230, 255) 100%);
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    padding: 10px;
    min-width: 220px;
}

/* Items du menu */
.dropdown-item {
    color: rgb(15, 55, 115);
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: flex;
    align-items: center;
    border-radius: 6px;
    transition: background-color 0.3s ease;
}

/* Effet de survol des items */
.dropdown-item:hover {
    background: linear-gradient(135deg, rgb(180, 220, 255) 0%, rgb(150, 200, 255) 100%);
}
.dropdown-menu {
    min-width: 500px; /* Ajuste selon tes besoins */
}
.actions-container {
    display: flex;
    align-items: center;
    gap: 15px; /* Espace entre les éléments */
}



.comments-box {
    max-height: 120px; /* Limit height */
    overflow-y: auto; /* Scroll when too many comments */
    background:rgb(243, 243, 243); /* Light background */
    padding: 10px;
    border-radius: 8px;
}

.comments-list {
    display: flex;
    flex-direction: column;
    gap: 6px; /* Space between comments */
}

.comment {
    background: #e9ecef; /* Light grey bubble */
    padding: 6px 12px;
    border-radius: 15px;
    display: inline-block;
    max-width: 90%;
}

.comment-user {
    font-weight: bold;
    color: #007bff;
}

.comment-text {
    color: #333;
}

.no-comments {
    color: #888;
    font-style: italic;
}

/* Container styling */
.filter-box {
  background-color: #fff;
  max-width: 600px;  /* adjust to your preference */
}

/* Icon styling */
.filter-icon {
  display: inline-block;
  font-size: 1.25rem;
  color:rgb(25, 75, 145); /* or any accent color you prefer */
