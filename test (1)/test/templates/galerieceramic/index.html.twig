<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

 

<script>
 function submitComment(oeuvreId) {
    const commentText = document.getElementById('comment-text-' + oeuvreId).value;

    if (commentText.trim() === '') {
        alert('Please write a comment before submitting.');
        return;
    }

    const formData = new FormData();
    formData.append('contenu', commentText);
    formData.append('oeuvre_id', oeuvreId);  // Ensure oeuvreId is being appended

    // Debugging: Log the FormData object to verify it's populated
    for (let [key, value] of formData.entries()) { 
        console.log(key + ': ' + value); 
    }

    fetch(`/commentaire/new/${oeuvreId}`, {
        method: 'POST',
        body: formData,
    })
    .then(response => {
        if (!response.ok) {
            return response.text().then(text => {
                throw new Error(`Network response was not ok: ${text}`);
            });
        }
        return response.json();
    })
    .then(data => {
        console.log(data);  // Log server response
        if (data.status === 'success') {
            const commentHtml = `
                <div class="comment">
                    <span class="comment-user">${data.comment.user}</span>: 
                    <span class="comment-text">${data.comment.contenu}</span>
                    <span class="comment-date" style="float: right; color: gray; font-size: 0.9rem;">
                        ${data.comment.date}
                    </span>
                </div>
            `;
            document.getElementById('comments-list-' + oeuvreId).innerHTML += commentHtml;
            document.getElementById('comment-text-' + oeuvreId).value = '';
            document.getElementById('comment-form-' + oeuvreId).style.display = 'none';
        } else {
            alert('There was an error submitting the comment.');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred. Please try again.');
    });
}

</script>

 


<style>
