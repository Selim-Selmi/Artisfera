{% extends 'base.html.twig' %}

{% block title %}Hello GalerieceramicController!{% endblock %}

{% block body %}

{{parent()}}
    <div class="page-wrapper">
        <section class="collection-grid collection-masonary">
            <div class="container">
                <div class="collection-grid__top">

 {% if 'ROLE_CERAMIQUE' in app.user.roles %}
 <div class="actions-container">
  <div class="dropdown">
        <button class="btn btn-nude dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            Actions
        </button>
        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
            <a class="dropdown-item" href="{{ path('app_ajout_oeuvre') }}">Ajouter une œuvre</a>
            <a class="dropdown-item" href="{{ path('app_ceramic_collection_new') }}">Créer une nouvelle collection</a>
            <a class="dropdown-item" href="{{ path('app_workshops_index') }}">Workshops</a>
        </div>
    </div>
</div>
{% endif %}
 

<!-- Search/Filter Form Container -->
<div class="filter-box mx-auto my-4 p-3 rounded shadow-sm">
  <form id="search-form" class="row g-2 align-items-center m-0">
    
    <!-- Icon (Filter or Search) -->
    <div class="col-auto">
      <span class="filter-icon">
        <i class="fas fa-filter"></i>
      </span>
    </div>

    <!-- Text Search Input -->
    <div class="col-sm">
      <div class="input-group">
        <input
          id="search-input"
          class="form-control border-0"
          type="search"
          placeholder="Rechercher une œuvre..."
          aria-label="Search"
        >
      </div>
    </div>

    <!-- Select Filter Type -->
    <div class="col-auto">
      <select id="filter-type" class="form-select border-0">
        <option value="nom">Nom</option>
        <option value="categorie">Catégorie</option>
        <option value="couleur">Couleur</option>
        <option value="type">Type</option>
        <option value="matiere">Matiere</option>
      </select>
    </div>

    <!-- Submit Button -->
    <div class="col-auto">
      <button class="btn btn-primary d-flex align-items-center" type="submit">
        <i class="fas fa-search me-1"></i>
        Filtrer
      </button>
    </div>

  </form>
</div>


                </div><!-- /.collection-grid__top -->       
              

                <div class="row high-gutter filter-layout masonary-layout">
                

                    {% if oeuvres is defined %}
                {% for oeuvre in oeuvres %}
                
                
    <div class="col-lg-4 col-md-6 filter-item masonary-item pic">
        <div class="collection-grid__single">
            <div class="collection-grid__image">
                <img src="{{ asset('uploads/images/' ~ oeuvre.image) }}"  alt="Image de l'œuvre {{ oeuvre.nom }}">
                  
                <!-- Bouton pour ouvrir le modal -->
                <a href="#" class="collection-grid__link" data-bs-toggle="modal" data-bs-target="#oeuvreModal{{ oeuvre.id }}">+</a>
            </div>
            <div class="collection-grid__content">
                <h3><a href="#">{{ oeuvre.nom }}</a></h3>
                <div class="button-group">
   
                    {% if oeuvre.user.id == app.user.id %}

<a href="#" class="delete-btn" data-url="{{ path('app_oeuvre_delete', { 'id': oeuvre.id }) }}">
    <i class="fas fa-trash-alt" style="color: black;"></i> <!-- Icône de suppression -->
</a>


    <a href="{{ path('app_edit_oeuvre', { 'id': oeuvre.id }) }}" >
        <i class="fas fa-edit" style="color: black;"></i> <!-- Icône d'édition -->
    </a>

    <!-- Comment Icon (opens the input field) -->
<!-- Comment Icon (opens the input field) -->
<a href="javascript:void(0);"  onclick="showComment({{ oeuvre.id }})">
    <i class="fa fa-comment" style="color: black;"></i>
</a>


<!-- Comment Input Field (Initially hidden) -->
<div id="comment-form-{{ oeuvre.id }}" class="comment-form" style="display:none;">
    <textarea id="comment-text-{{ oeuvre.id }}" class="form-control" placeholder="Write your comment..."></textarea>
    <button class="btn btn-success" onclick="submitComment({{ oeuvre.id }})">
        <i class="fa fa-plus"></i>
    </button>
   
</div>
</div>
<!-- Comments List -->
<div class="comments-box">
    <h6 class="mb-2">Commentaires :</h6>
    <div class="comments-list" id="comments-list-{{ oeuvre.id }}">
        {% for commentaire in oeuvre.commentaires %}
            <div class="comment">
                <span class="comment-user">{{ commentaire.user.nom }}</span>: 
                <span class="comment-text">{{ commentaire.contenu }}</span>
                <span class="comment-date" style="float: right; color: gray; font-size: 0.9rem;">
                    {{ commentaire.date|date('d-m-Y H:i') }}
                </span>

               
            </div>
        {% else %}
            <div class="no-comments">Aucun commentaire pour cette œuvre.</div>
        {% endfor %}
    </div>
</div>
{% endif %}
            </div>
        </div>
    </div>

    <!-- Modal Détails avec image à gauche et infos à droite -->
    <div class="modal fade" id="oeuvreModal{{ oeuvre.id }}" tabindex="-1" aria-labelledby="oeuvreModalLabel{{ oeuvre.id }}" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="oeuvreModalLabel{{ oeuvre.id }}">{{ oeuvre.nom }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <!-- Image à gauche -->
                        <div class="col-md-5">
                            <img src="{{ asset('uploads/images/' ~ oeuvre.image) }}" class="img-fluid rounded" alt="{{ oeuvre.nom }}">
                        </div>
                        <!-- Infos à droite -->
                        <div class="col-md-7">
                            <p><strong>Type:</strong> {{ oeuvre.type }}</p>
                            <p><strong>Description:</strong> {{ oeuvre.description }}</p>
                            <p><strong>Matière:</strong> {{ oeuvre.matiere }}</p>
                            <p><strong>Couleur:</strong> {{ oeuvre.couleur }}</p>
                            <p><strong>Dimensions:</strong> {{ oeuvre.dimensions }}</p>
                            <p><strong>Créateur:</strong>  {{oeuvre.user.nom}}</p>
                            <p><strong>Catégorie:</strong> {{ oeuvre.categorie }}</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
{% endfor %}
                    {% endif %} 
 
                </div><!-- /.row -->
            </div><!-- /.container -->
        </section><!-- /.collection-grid -->
    </div><!-- /.page-wrapper -->
    <!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


<script>
document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll('.delete-btn').forEach(button => {
        button.addEventListener('click', function(event) {
            event.preventDefault(); // Prevent default navigation

            let deleteUrl = this.getAttribute('data-url');

            Swal.fire({
                title: "Are you sure?",
                text: "This artwork will be permanently deleted.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = deleteUrl; // Redirect to delete route
                }
            });
        });
    });
});
</script>

