{% extends 'base.html.twig' %}

{% block title %}Détails du Textile{% endblock %}

{% block body %}
{{ parent() }}

<div class="container mt-5">
    <h1 class="text-primary text-center mb-4">🧵 Détails du Textile</h1>

    <div class="card shadow-sm p-4 rounded-4">
        <div class="row">
            <!-- Image du textile -->
            <div class="col-md-4 text-center">
                <img src="{{ asset(textile.image) }}" alt="{{ textile.nom }}" 
                     class="img-fluid rounded shadow-sm"
                     style="max-height: 300px; object-fit: contain; background-color: #f8f9fa;">
            </div>

            <!-- Informations du textile -->
            <div class="col-md-8">
                <h2 class="fw-bold text-dark">{{ textile.nom }}</h2>
                <p class="text-muted mb-2"><strong>📌 Type :</strong> {{ textile.type }}</p>
                <p class="text-muted"><strong>📝 Description :</strong> {{ textile.description }}</p>
                <hr>
                <p><strong>🧶 Matière :</strong> {{ textile.matiere }}</p>
                <p><strong>🎨 Couleur :</strong> {{ textile.couleur }}</p>
                <p><strong>📏 Dimension :</strong> {{ textile.dimension }}</p>
                <p><strong>👤 Créateur :</strong> {{ textile.createur }}</p>
                <p><strong>⚒️ Technique :</strong> {{ textile.technique }}</p>

                <div class="d-flex justify-content-start gap-3 mt-4">
                    <a href="{{ path('app_textile_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                    <a href="{{ path('app_textile_edit', {'id': textile.id}) }}" class="btn btn-primary">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    {{ include('textile/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.3s ease-in-out;
    }

    .card:hover {
        transform: scale(1.02);
    }
</style>

{% endblock %}
