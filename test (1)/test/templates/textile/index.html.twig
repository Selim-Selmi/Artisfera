{% extends 'base.html.twig' %}

{% block body %}
{{ parent() }}

<div class="container mt-5">
    <h1 class="text-center mb-4 ">📌 Collections des Textiles</h1>

    <!-- Filtres & Boutons -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <label for="collectionFilter" class="form-label fw-bold">🎨 Filtrer par Collection :</label>
            <select id="collectionFilter" class="form-select shadow-sm">
                <option value="all">Toutes les collections</option>
                {% for collection in collections %}
                    <option value="collection-{{ collection.id }}">{{ collection.nom }}</option>
                {% endfor %}
            </select>
        </div>
        
        {% if 'ROLE_TEXTILE' in app.user.roles %}
        <div class="d-flex gap-4">
            <a href="{{ path('app_collections_new') }}" class="btn btn-success shadow-sm">
                <i class="fas fa-folder-plus"></i> Nouvelle Collection
            </a>            
            <a href="{{ path('app_textile_new') }}" class="btn btn-success shadow-sm">
                <i class="fas fa-plus-circle"></i> Nouvelle piéce
            </a>
        </div>
        {% endif %}
    </div>

    <!-- Liste des textiles -->
    <div class="row row-cols-1 row-cols-md-3 g-4" id="textileContainer">
        {% for collection in collections %}
            {% for textile in collection.textiles %}
                <div class="col textile-item collection-{{ collection.id }}">
                    <div class="card shadow-sm border-0 rounded-4">
                        <img src="{{ asset(textile.image) }}" alt="Image du textile" 
                             class="card-img-top rounded-top img-fluid" 
                             style="height: 200px; object-fit: contain; background-color: #f8f9fa;">

                        <div class="card-body text-center">
                            <h5 class="card-title text-dark fw-bold">{{ textile.nom }}</h5>
                            <p class="text-muted small">📁 Collection : <span class="fw-bold">{{ collection.nom }}</span></p>

                            <div class="d-flex justify-content-center gap-2">
                                <a href="{{ path('app_textile_edit', {'id': textile.id}) }}" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                {# <a href="{{ path('app_textile_delete', {'id': textile.id}) }}" class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash"></i> Supprimer
                                </a> #}
                                <a href="{{ path('app_textile_show', {'id': textile.id}) }}" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-info-circle"></i> Détails
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
</div>

<!-- Script pour le filtre -->
<script>
    document.getElementById("collectionFilter").addEventListener("change", function() {
        let selectedCollection = this.value;
        let textiles = document.querySelectorAll(".textile-item");

        textiles.forEach(textile => {
            textile.style.display = (selectedCollection === "all" || textile.classList.contains(selectedCollection)) 
                ? "block" 
                : "none";
        });
    });
</script>

<style>
.card:hover {
    transform: scale(1.03);
    transition: 0.3s ease-in-out;
}
</style>

{% endblock %}
