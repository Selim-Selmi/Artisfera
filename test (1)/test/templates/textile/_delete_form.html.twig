<form method="post" action="{{ path('app_textile_delete', {'id': textile.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ textile.id) }}">
    <button type="submit" class="btn btn-danger">
        <i class="fas fa-trash-alt"></i> Supprimer
    </button>
</form>
